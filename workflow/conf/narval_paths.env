# Shared canonical worker layout and resource policies; Narval site identity.
source "$WIGITS_WORKFLOW_DIR/conf/fir_paths.env"
export WIGITS_SITE_CONFIG="$WIGITS_WORKFLOW_DIR/conf/narval.config"
# The same 64-CPU/768-GiB/7-day ceilings; task-local sizing is unchanged.
export WIGITS_SITE_LIMITS_CONFIG="$WIGITS_WORKFLOW_DIR/conf/fir_limits.config"
export WIGITS_FINAL_CONFIG="$WIGITS_SITE_LIMITS_CONFIG"
export WIGITS_EXTENSIONS_SITE_CONFIG="$WIGITS_SITE_CONFIG"
