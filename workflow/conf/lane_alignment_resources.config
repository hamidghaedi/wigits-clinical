// input-v3.1: fixed CPU/RAM; only time evaluates the actual task's R1+R2.
// Keep these formulas synchronized with alignment_allocation() and its real-Nextflow canary.
process {
    withName: 'BWAMEM2_ALIGN' {
        cpus = 64
        memory = 224.GB
        time = {
            def gib = (reads_fwd.size() + reads_rev.size()) / 1073741824d
            def hours = 2 * Math.ceil(Math.max(4d, gib / 8d) / 2d)
            if (hours > 336) throw new IllegalArgumentException('Lane exceeds input-v3 time envelope')
            hours.h
        }
    }
}
