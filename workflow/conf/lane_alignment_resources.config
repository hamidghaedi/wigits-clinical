// input-v4: CPU64 fixed; RAM/time use the actual task's R1+R2 and observed allowances.
// Keep these formulas synchronized with alignment_allocation() and its real-Nextflow canary.
process {
    withName: 'BWAMEM2_ALIGN' {
        cpus = 64
        memory = {
            def gib = (reads_fwd.size() + reads_rev.size()) / 1073741824d
            def gb = 16 * Math.ceil((48d + 2d * gib) / 16d)
            if (gb > 768) throw new IllegalArgumentException('Lane exceeds input-v4 memory envelope')
            gb.GB
        }
        time = {
            def estimatedPairs = (reads_fwd.size() + reads_rev.size()) / 120d
            def hours = Math.ceil(Math.max(60d, 2d * estimatedPairs / 4000000d + 15d) / 60d)
            if (hours > 336) throw new IllegalArgumentException('Lane exceeds input-v4 time envelope')
            hours.h
        }
    }
}
