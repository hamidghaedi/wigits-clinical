// input-v3 alignment policy. Evaluate the actual task's R1+R2, never its whole library.
// Keep these formulas synchronized with alignment_allocation() and its real-Nextflow canary.
process {
    withName: 'BWAMEM2_ALIGN' {
        cpus = {
            def gib = (reads_fwd.size() + reads_rev.size()) / 1073741824d
            gib > 10d ? 64 : 16
        }
        memory = {
            def gib = (reads_fwd.size() + reads_rev.size()) / 1073741824d
            def gb = 32 * Math.ceil((64d + 2d * gib + 0.5d * task.cpus) / 32d)
            if (gb > 768) throw new IllegalArgumentException('Lane exceeds input-v3 memory envelope')
            gb.GB
        }
        time = {
            def gib = (reads_fwd.size() + reads_rev.size()) / 1073741824d
            def hours = 2 * Math.ceil(Math.max(4d, gib / 8d * 64d / task.cpus) / 2d)
            if (hours > 336) throw new IllegalArgumentException('Lane exceeds input-v3 time envelope')
            hours.h
        }
    }
}
