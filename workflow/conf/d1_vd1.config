// Native custom-genome interface. Never pair these BAMs with the HMF FASTA.
// Missing indexes are built by Oncoanalyser's PREPARE_REFERENCE on Slurm.
params {
    genomes {
        GRCh38_d1_vd1 {
            fasta = '/global/project/hpcg6049/somatic_pipeline/data/references/GRCh38.d1.vd1.fa'
            fai = '/global/project/hpcg6049/somatic_pipeline/data/references/GRCh38.d1.vd1.fa.fai'
            dict = '/global/project/hpcg6049/somatic_pipeline/data/references/GRCh38.d1.vd1.dict'
        }
    }
}
