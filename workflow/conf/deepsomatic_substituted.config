/*
 * deepsomatic_substituted.config — run-scoped settings for sage_dir-substituted (DeepSomatic) oncoanalyser runs.
 * Add after conf/frontenac.config and conf/frontenac_limits.config:
 *   sbatch workflow/run_oncoanalyser_frontenac.sh <run_id> <samplesheet> -c workflow/conf/deepsomatic_substituted.config \
 *       --processes_exclude neo,sage_visualiser
 * Why: the adapter VCF (workflow/sage_compat) carries no RC_INFO/RC_CNT, so SAGE_APPEND and NEO cannot consume it
 * (docs/DEEPSOMATIC_WIRING_CONTRACT.md §4.3) and SAGE_VISUALISER re-derives read contexts from it; RNA rows are omitted
 * from the samplesheet, SAGE_APPEND is additionally disabled here as a guard. PURPLE runs at TRACE once so that
 * logFilteredFittingCandidate reasons and fitting-variant counts are captured (contract §6.3).
 * Resources: pass 2 re-runs only the SAGE-independent per-sample tools plus the small-variant chain; requests are kept
 * small (<=16 CPU, <=6 h where the route C runtime allows) so that they backfill on a busy cluster. Route C realtimes
 * at 64 CPU: SAGE_GERMLINE 1 m, BAMTOOLS 14 m / 3 m, CIDER 2 m, TEAL_PREP 1 h 18 m, LILAC 40 s, PURPLE 38 s.
 */
process {
    resourceLimits = [cpus: 64, memory: 180.GB, time: 14.d]
    withName: 'SAGE_GERMLINE' { cpus = 8;  memory = 32.GB; time = 4.h }
    withName: 'BAMTOOLS'      { cpus = 16; memory = 48.GB; time = 6.h }
    withName: 'LILAC'         { cpus = 16; memory = 48.GB; time = 6.h }
    withName: 'CIDER'         { cpus = 8;  memory = 32.GB; time = 4.h }
    withName: 'TEAL_PREP'     { cpus = 16; memory = 48.GB; time = 12.h }
    withName: 'PURPLE'        { cpus = 8;  memory = 48.GB; time = 6.h; ext.log_level = 'TRACE' }
    withName: 'PAVE_SOMATIC'  { ext.log_level = 'DEBUG' }
    withName: 'SAGE_APPEND.*' { ext.when = false }
}
