/*
 * frontenac.config — site configuration for nf-core/oncoanalyser on Frontenac (CAC, Queen's).
 *
 * Conventions mirror the proven dnaseq_nf settings
 * (../../dnaseq_nf/conf/slurm.config, containers.config) and the Frontenac rules in
 * ../../somatic_pipeline_sm/AGENTS.md ("Cluster Resources"):
 *   - account only, never --partition (the scheduler routes by walltime)
 *   - Apptainer, autoMounts, shared SIF cache under containers/NXF_SINGULARITY_CACHEDIR
 *   - throttled squeue polling (3 heads/cluster once hammered squeue and lost jobs)
 *
 * Verified facts (probe job 12348002, 2026-10-14): compute nodes have outbound internet,
 * can sbatch, and run apptainer 1.3.5; nodes have 188 GB RAM. Nextflow work dir must be on
 * /global (GPFS), never /tmp.
 *
 * Usage (test):       nextflow run nf-core/oncoanalyser -r 3.0.0 -profile test,apptainer -c conf/frontenac.config ...
 * Usage (production): ... -profile apptainer -c conf/frontenac.config -c conf/frontenac_limits.config ...
 */

params {
    config_profile_name        = 'Frontenac (CAC)'
    config_profile_description = 'Slurm + Apptainer site config for nf-core/oncoanalyser on Frontenac'
    config_profile_contact     = 'hpc6049'
}

process {
    executor       = 'slurm'
    clusterOptions = '--account=def-hpcg6049_cpu'
    // TMPDIR: ~/.bashrc exports TMPDIR=/global/scratch/hpc6049/tmp, Nextflow forwards it into the
    // container (APPTAINERENV_TMPDIR) but only binds the work dir, so sambamba sort failed with
    // "Read-only file system" (job 12348019, 2026-10-14). Use the node-local $SLURM_TMPDIR
    // (/lscratch, 462 GB xfs) and bind it; fall back to the task dir when not under Slurm.
    beforeScript   = 'module load apptainer/1.3.5; export TMPDIR="${SLURM_TMPDIR:-$PWD}"'
    // resourceLimits deliberately NOT set here: a -c file outranks -profile test, and the test
    // profile's small clamps (4 CPU / 30 GB / 1 h) must survive for smoke tests. Production runs add
    // -c conf/frontenac_limits.config (node ceiling 32 CPU / 180 GB / 14 d).
}

executor {
    name              = 'slurm'
    queueSize         = 50
    submitRateLimit   = '10/1min'
    queueStatInterval = '2 min'
    pollInterval      = '30 sec'
    exitReadTimeout   = '15 min'
}

apptainer {
    enabled     = true
    autoMounts  = true
    cacheDir    = '/global/project/hpcg6049/somatic_pipeline/containers/NXF_SINGULARITY_CACHEDIR'
    pullTimeout = '2 h'
    // Expanded by bash in .command.run at task launch (see TMPDIR note above).
    runOptions  = '-B "${SLURM_TMPDIR:-$PWD}"'
}
singularity.enabled = false
docker.enabled      = false
