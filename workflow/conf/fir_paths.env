# Owner-operated Fir layout. Override roots only through the issued site.env.
WIGITS_PROJECT_ROOT="${WIGITS_PROJECT_ROOT:-$HOME/projects/def-ghaedi/$USER/mohcc}"
WIGITS_SCRATCH_ROOT="${WIGITS_SCRATCH_ROOT:-/scratch/$USER/mohcc}"
CONTAINER_DIR="$WIGITS_PROJECT_ROOT/resources/containers"
REF_ROOT="$WIGITS_PROJECT_ROOT/resources"
ONCO_REF_ROOT="$REF_ROOT/oncoanalyser"
KB_ROOT="$REF_ROOT/knowledgebases"
SOFTWARE_ROOT="$WIGITS_PROJECT_ROOT/releases"
ONCO_SOURCE_VERSION=3.0.0-qlmp.2.2
ONCO_REFERENCE_VERSION=3.0.0
ONCO_SOURCE_DIR="$SOFTWARE_ROOT/oncoanalyser/$ONCO_SOURCE_VERSION"
RUN_ROOT="${WIGITS_RUN_ROOT:?Bind WIGITS_RUN_ROOT to the versioned analysis directory}"
RELEASE_ROOT="$WIGITS_PROJECT_ROOT/releases"
SLURM_ACCOUNT_CPU="${WIGITS_SLURM_ACCOUNT:-def-ghaedi}"
NEXTFLOW_MODULE="${WIGITS_NEXTFLOW_MODULE:-nextflow/26.04.4}"
APPTAINER_MODULE="${WIGITS_APPTAINER_MODULE:-apptainer/1.3.5}"
export WIGITS_SLURM_ACCOUNT="$SLURM_ACCOUNT_CPU"
export WIGITS_APPTAINER_MODULE="$APPTAINER_MODULE"
export WIGITS_CONTAINER_DIR="$CONTAINER_DIR"
export WIGITS_APPTAINER_CACHE="$WIGITS_SCRATCH_ROOT/.cache/apptainer"
export NXF_PLUGINS_DIR="$WIGITS_PROJECT_ROOT/resources/nextflow/plugins"
export WIGITS_SITE_CONFIG="$WIGITS_WORKFLOW_DIR/conf/fir.config"
export WIGITS_SITE_LIMITS_CONFIG="$WIGITS_WORKFLOW_DIR/conf/fir_limits.config"
export WIGITS_FINAL_CONFIG="$WIGITS_SITE_LIMITS_CONFIG"
export WIGITS_EXTENSIONS_SITE_CONFIG="$WIGITS_SITE_CONFIG"
