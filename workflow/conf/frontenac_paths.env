# frontenac_paths.env — machine-readable form of docs/directory_layout.md (the canonical contract).
# Source this; never hard-code these paths elsewhere. Change both files in the same commit.
#   source /global/project/hpcg6049/somatic_pipeline/wigits-clinical/workflow/conf/frontenac_paths.env
PIPELINE_ROOT="/global/project/hpcg6049/somatic_pipeline"
WIGITS_REPO="${PIPELINE_ROOT}/wigits-clinical"

# Shared, immutable, large (project storage) — shared with somatic_pipeline_sm / dnaseq_nf
CONTAINER_DIR="${PIPELINE_ROOT}/containers/NXF_SINGULARITY_CACHEDIR"   # existing
REF_ROOT="${PIPELINE_ROOT}/data/references"                             # existing
ONCO_REF_ROOT="${REF_ROOT}/oncoanalyser"                                # new: <oncoanalyser-version>/ below it
KB_ROOT="${PIPELINE_ROOT}/data/knowledgebases"                          # new, reserved: <source>/<version>/
SOFTWARE_ROOT="${PIPELINE_ROOT}/software"                               # new, reserved: pinned pipeline checkouts

# Mutable, large, regenerable (scratch)
RUN_ROOT="/global/scratch/hpc6049/wigits_runs"                          # new: <run_id>/{work,results,logs}

# Durable run outputs we keep (project storage)
RELEASE_ROOT="${PIPELINE_ROOT}/wigits_releases"                         # new: <run_id>/

# Slurm
SLURM_ACCOUNT_CPU="def-hpcg6049_cpu"
SLURM_ACCOUNT_GPU="def-hpcg6049_gpu"
# Never pass --partition on Frontenac; the scheduler routes by walltime.

# Modules (oncoanalyser 3.0.0 needs Nextflow >= 25.10.4)
NEXTFLOW_MODULE="nextflow/26.04.4"
APPTAINER_MODULE="apptainer/1.3.5"
