// Site binding only. Native modules, callers and input-v5 remain unchanged.
params.config_profile_name = 'Fir owner-operated'
process {
    executor = 'slurm'
    clusterOptions = "--account=${System.getenv('WIGITS_SLURM_ACCOUNT')}"
    beforeScript = "module load ${System.getenv('WIGITS_APPTAINER_MODULE')}; " + 'export TMPDIR="${SLURM_TMPDIR:-$PWD}"'
}
executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10/1min'
    queueStatInterval = '2 min'
    pollInterval = '30 sec'
    exitReadTimeout = '15 min'
}
apptainer {
    enabled = true
    autoMounts = true
    cacheDir = System.getenv('WIGITS_CONTAINER_DIR')
    pullTimeout = '2 h'
    runOptions = '-B /home,/project,/scratch -B "${SLURM_TMPDIR:-$PWD}"'
}
singularity.enabled = false
docker.enabled = false
