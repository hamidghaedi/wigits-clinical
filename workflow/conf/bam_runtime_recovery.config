// Recovery v0.1.0. No caller/reference/resource changes.
process {
    withName: 'CIDER' {
        // beforeScript runs before staging; a relative symlink can point to the
        // dictionary Nextflow is about to stage. Keep the canonical file intact.
        beforeScript = '''
            module load apptainer/1.3.5
            export TMPDIR="${SLURM_TMPDIR:-$PWD}"
            ln -sfn GRCh38.d1.vd1.dict GRCh38.d1.vd1.fa.dict
        '''
    }
    withName: 'ESVEE' {
        // The crash PC is inside C2-compiled AbstractBAMFileIndex.query.
        // Interpret only this method; retain Java/tool versions and other JIT.
        // Env-file preserves the comma in the JVM flag; --env parses commas.
        containerOptions = '--env-file @ESVEE_ENV_FILE@'
    }
}
