/*
 * frontenac_limits.config — production resource ceilings for Frontenac CPU nodes.
 * Add AFTER conf/frontenac.config for real runs; omit for -profile test (see frontenac.config).
 * Frontenac CPU nodes: 188 GB RAM (probe job 12348002); cpubase_14days is the longest walltime.
 * nf-core's process_high_memory label asks 200 GB, which no node here can satisfy — this clamps it.
 */
process {
    resourceLimits = [ cpus: 32, memory: 180.GB, time: 14.d ]
}
