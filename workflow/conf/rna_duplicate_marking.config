// RNA duplicate marking v0.1.0. Keep ordinary duplicate flags and all reads.
// Picard recommends skipping optical comparisons for large RNA duplicate sets.
// Optical-duplicate counts and optical-adjusted library size are not assessed.
// https://broadinstitute.github.io/picard/command-line-overview.html#MarkDuplicates
process {
    withName: '.*:READ_ALIGNMENT_RNA:GATK4_MARKDUPLICATES' {
        ext.args = '--READ_NAME_REGEX null'
    }
}
